{
  "name": "qalam-app",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "@capacitor-community/text-to-speech": "8.0.2",
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.0",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/share": "8.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "glob": "14.0.2",
    "minimatch": "11.0.1"
  },
  "scripts": {
    "check": "node scripts/check.cjs",
    "prepare:web": "node scripts/prepare-web.cjs",
    "build": "npm run check && npm run prepare:web && npx cap sync android",
    "android:debug": "npm run build && cd android && ./gradlew assembleDebug",
    "android:bundle": "npm run build && cd android && ./gradlew bundleRelease"
  }
}
